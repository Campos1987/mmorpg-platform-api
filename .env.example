# =============================================================================
# .env.example — Variáveis de ambiente para o docker-compose
#
# 1. Copie este arquivo:  cp .env.example .env
# 2. Edite o .env com seus valores reais
# 3. O .env NUNCA deve ser commitado no git (já está no .gitignore)
#
# Pré-requisito:
#   O container 'mysql-l2_game' e a rede 'mmorpg-net' devem estar rodando.
# =============================================================================

# Perfil Spring ativo (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# --- Credenciais do banco (container mysql-l2_game na rede mmorpg-net) ---
MYSQL_DATABASE=gk_web_user
MYSQL_USER=gk_web_user
MYSQL_PASSWORD=Abc1234

# --- CORS (origens permitidas pelo frontend, separadas por vírgula) ---
CORS_ORIGINS=http://localhost:3000
